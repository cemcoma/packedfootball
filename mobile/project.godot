; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Packed Football Mobile"
run/main_scene="res://scenes/Auth.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

FirebaseAuth="*res://scripts/autoload/FirebaseAuth.gd"
Firestore="*res://scripts/autoload/Firestore.gd"
Backend="*res://scripts/autoload/Backend.gd"
GameProfile="*res://scripts/autoload/GameProfile.gd"
MatchSession="*res://scripts/autoload/MatchSession.gd"
PackSession="*res://scripts/autoload/PackSession.gd"
IapClient="*res://scripts/autoload/IapClient.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/handheld/orientation="landscape"

[editor_plugins]

enabled=PackedStringArray("res://addons/godotx_revenue_cat/plugin.cfg")

[gui]

theme/custom="res://theme/AppTheme.tres"

[rendering]

textures/vram_compression/import_etc2_astc=true
