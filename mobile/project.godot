; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/ios/app_id="ca-app-pub-1704438625576029~3392195452"

[application]

config/name="Packed Football Mobile"
run/main_scene="res://scenes/Splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.050980393, 0.08235294, 0.14901961, 1)
boot_splash/stretch_mode=4
boot_splash/image="res://sprites/splash/boot/boot_splash.png"

[autoload]

FirebaseAuth="*res://scripts/autoload/FirebaseAuth.gd"
Firestore="*res://scripts/autoload/Firestore.gd"
Backend="*res://scripts/autoload/Backend.gd"
GameProfile="*res://scripts/autoload/GameProfile.gd"
MatchSession="*res://scripts/autoload/MatchSession.gd"
PackSession="*res://scripts/autoload/PackSession.gd"
IapClient="*res://scripts/autoload/IapClient.gd"
ThemeManager="*res://scripts/autoload/ThemeManager.gd"
PlayerSession="*res://scripts/autoload/PlayerSession.gd"
ManagerSession="*res://scripts/autoload/ManagerSession.gd"
AdManager="*uid://d1x5ac4vymns1"
LocaleManager="*res://scripts/autoload/LocaleManager.gd"
CurrencyHud="*res://scripts/autoload/CurrencyHud.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/godotx_revenue_cat/plugin.cfg")

[gui]

theme/custom="res://theme/AppTheme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://translations/tr.po")

[rendering]

textures/vram_compression/import_etc2_astc=true
