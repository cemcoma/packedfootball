rules_version = '2';

// PRODUCTION POSTURE
// Every write that can affect game balance or economy goes through
// backend/main.py (Cloud Run, Admin SDK -- AdminFirestoreClient, not
// subject to these rules at all): pack opening, match results, currency
// exchange/IAP/deals, and every players/{id} card mutation. The client
// only ever writes directly for a small, explicitly enumerated set of
// low-stakes fields (confirmed by grepping every Firestore.set_document/
// add_document/delete_document call site in mobile/scripts/): a manager's
// own display_name, their live roster_player_ids/formation, their kit
// (cosmetic shirt colors), and their own inventory pointers. Everything
// else is deny-by-default, both at the collection level (no match block at
// all for packs/deals/iap_transactions -- an unmatched path is denied
// automatically) and at the field level (users/{uid}'s update rule
// allow-lists exactly those 4 fields, rather than block-listing the ones
// known to be sensitive -- a
// block-list needs remembering to add every new sensitive field forever,
// which is exactly how wins/losses/draws stayed client-writable long after
// credits moved server-side; an allow-list fails closed automatically for
// any field -- present today or added later -- that isn't named).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['display_name', 'roster_player_ids', 'formation', 'kit']);
      allow delete: if false;

      match /inventory/{invId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /players/{playerId} {
      allow read: if request.auth != null && resource.data.owner_uid == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}
