# Copy to .env (gitignored, and excluded from the Docker build context via
# the repo-root .dockerignore -- never baked into the deployed image) and fill in
# real values for local development. The DEPLOYED Cloud Run service does
# NOT read this file -- it gets these same variables via
# `gcloud run deploy --set-env-vars` / `--set-secrets` instead (see
# backend/README.md's "Deploying" section). This is purely a shortcut so
# `uvicorn main:app` works locally without exporting a dozen variables by
# hand first.

# Defaults to "packedfootball" in code if unset -- only needed here if
# you're pointing a local run at a different Firebase project.
FIREBASE_PROJECT_ID=packedfootball

# Required for POST /webhooks/revenuecat to accept anything at all (fails
# closed with no default) -- must exactly match the "Authorization header
# value" configured in RevenueCat's own webhook dashboard settings. This is
# a secret YOU generate `openssl rand -hex 32`
REVENUECAT_WEBHOOK_SECRET=

# Required for POST /tournament/settle to accept anything at all (fails
# closed with no default, same as the webhook secret above). A scheduled
# invoker has no Firebase ID token, so this is how Cloud Scheduler
# authenticates itself when it asks the backend to settle yesterday's
# tournaments. A secret YOU generate: `openssl rand -hex 32`.

# Settlement ALSO happens lazily on any /tournament/* request, so leaving
# this unset doesn't break the feature -- it only means nothing settles
# punctually at midnight, and a day where no player returns stays open until
# one does.
TOURNAMENT_ADMIN_SECRET=
